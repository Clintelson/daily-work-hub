<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/dwh_splash_logo">
    <target android:name="logo">
        <aapt:attr name="android:animation">
            <!-- One gentle pulse/lift, then back to the static logo. No loop. -->
            <objectAnimator android:duration="500" android:repeatCount="1"
                android:repeatMode="reverse"
                android:interpolator="@android:interpolator/fast_out_slow_in">
                <propertyValuesHolder android:propertyName="scaleX"
                    android:valueFrom="1" android:valueTo="1.025" android:valueType="floatType" />
                <propertyValuesHolder android:propertyName="scaleY"
                    android:valueFrom="1" android:valueTo="1.025" android:valueType="floatType" />
                <propertyValuesHolder android:propertyName="translateY"
                    android:valueFrom="0" android:valueTo="-6" android:valueType="floatType" />
            </objectAnimator>
        </aapt:attr>
    </target>
</animated-vector>
